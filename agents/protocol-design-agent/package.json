{
  "name": "@life-sciences-agents/protocol-design-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "review": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:live-tools": "RUN_LIVE_TESTS=1 node --experimental-strip-types --test tests/production-integrity.test.ts",
    "test:e2e:model": "RUN_MODEL_E2E=1 node --experimental-strip-types --test tests/model-e2e.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openai/agents": "^0.22.0",
    "zod": "^4.6.7"
  }
}
